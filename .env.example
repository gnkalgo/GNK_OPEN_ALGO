FRONTEND_URL=https://gnkalgo.com
ENVIRONMENT=production
COOKIE_SECURE=true
# Set false for a live-only server. This never bypasses Dhan activation checks.
PAPER_TRADING_ENABLED=false
# Generate your own values. URL-encode any special characters in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://gnk:replace-with-a-long-random-password@postgres:5432/gnk
REDIS_URL=redis://redis:6379/0
SESSION_TTL=28800
LIVE_SESSION_TTL_SECONDS=900
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@gnkalgo.com
SMTP_STARTTLS=true
DHAN_PARTNER_ID=
DHAN_PARTNER_SECRET=
# Use individual for an API Key/Secret generated in Dhan Web; partner for issued partner credentials.
DHAN_AUTH_MODE=partner
DHAN_CLIENT_ID=
DHAN_API_KEY=
DHAN_API_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DHAN_TOKEN_ENCRYPTION_KEY=
FYERS_CLIENT_ID=
FYERS_APP_SECRET=
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Dhan limited live pilot. Leave disabled until deployment acceptance and broker approval.
DHAN_LIVE_ENABLED=false
DHAN_LIVE_APPROVED=false
# Fixed server egress address registered at Dhan. This is not the browser's IP.
DHAN_EXECUTION_IP=
# Private comma-separated approved Dhan account IDs; never put these in VITE variables.
DHAN_LIVE_ACCOUNT_IDS=
# Approved numeric NSE EQ security IDs, imported from the official master each trading day.
DHAN_LIVE_SECURITY_IDS=
DHAN_LIVE_MAX_ORDER_VALUE=50000
DHAN_LIVE_MAX_DAILY_VALUE=50000
DHAN_LIVE_MAX_QUANTITY=10
